            },
            "loading": {
              "applicability": "applicable"
            },
            "success": {
              "applicability": "not-applicable",
              "reason": "성공 결과는 화면 전환으로 표현"
            }
          }
        },
        "semantics": "화면당 하나뿐인 주 동작 (밤 계획 만들기, 이대로 잘게요, 일어날게요, 집으로 안내)",
        "states": [
          "default",
          "pressed",
          "disabled"
        ],
